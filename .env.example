# Admin Panel Credentials
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git
VITE_ADMIN_USERNAME=your_admin_username
VITE_ADMIN_PASSWORD=your_strong_password_here

# Google Analytics
VITE_GA_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX

# Microsoft Clarity (heatmaps & session replay)
VITE_CLARITY_ID=your_clarity_project_id

# EmailJS (contact form notifications)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_TEMPLATE_CONTACT=template_xxxxx
VITE_EMAILJS_TEMPLATE_REVIEW=template_xxxxx

# Supabase (newsletter subscribers, affiliate metrics)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
