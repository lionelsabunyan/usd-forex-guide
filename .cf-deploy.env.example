# Cloudflare Pages deploy credentials.
# Copy this file to `.cf-deploy.env` (which is gitignored) and fill in real values.
# Used by `scripts/deploy.sh`.
#
# Create a SCOPED token at https://dash.cloudflare.com/profile/api-tokens
#   Permissions: Account → Cloudflare Pages → Edit   (least privilege — nothing else)
# The account id is shown on the Cloudflare dashboard home / in `wrangler whoami`.

CLOUDFLARE_API_TOKEN=your_scoped_pages_edit_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
